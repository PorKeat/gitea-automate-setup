<style>
/* 
 * Sleek Monochromatic Theme Overrides
 * Matches the black and white PES EXPO logo
 */

/* Animations */
.logo {
    transition: filter 0.3s ease, transform 0.3s ease;
}
.logo:hover {
    transform: scale(1.02);
}

/* Light Mode Specifics */
html.theme-gitea-light, html.theme-gitea-auto {
    /* Invert the white logo to black for light mode! */
    --logo-filter: invert(1);
    
    --color-primary: #333333 !important;
    --color-primary-contrast: #ffffff !important;
    --color-primary-dark-1: #222222 !important;
    --color-primary-dark-2: #111111 !important;
    --color-primary-dark-3: #000000 !important;
    --color-primary-light-1: #444444 !important;
    --color-primary-light-2: #555555 !important;
    --color-primary-light-3: #666666 !important;
}

html.theme-gitea-light img.logo, 
html.theme-gitea-auto img.logo {
    filter: invert(1);
}

/* Dark Mode Specifics */
html.theme-gitea-dark {
  --color-primary: #888888 !important;
  --color-primary-contrast: #ffffff !important;
  --color-primary-dark-1: #777777 !important;
  --color-primary-dark-2: #666666 !important;
  --color-primary-dark-3: #555555 !important;
  --color-primary-dark-4: #444444 !important;
  --color-primary-dark-5: #333333 !important;
  --color-primary-dark-6: #222222 !important;
  --color-primary-dark-7: #111111 !important;
  --color-primary-light-1: #999999 !important;
  --color-primary-light-2: #aaaaaa !important;
  --color-primary-light-3: #bbbbbb !important;
  --color-primary-light-4: #cccccc !important;
  --color-primary-light-5: #dddddd !important;
  --color-primary-light-6: #eeeeee !important;
  --color-primary-light-7: #f5f5f5 !important;
}

/* Force primary buttons (like Sign In) to be a sleek dark grey on all themes */
.ui.primary.button, .ui.primary.buttons .button { 
    background-color: var(--color-primary-dark-1) !important; 
    color: #ffffff !important; 
    border: 1px solid var(--color-primary-dark-3) !important;
    transition: background-color 0.2s ease;
}
.ui.primary.button:hover, .ui.primary.buttons .button:hover { 
    background-color: var(--color-primary-light-2) !important; 
}



/* Links */
a { color: #cccccc; }
a:hover { color: #ffffff; }

/* Subdue the green checkmarks / success colors slightly to fit better if needed */
.ui.green.button, .ui.green.buttons .button {
    background-color: #555555 !important;
}
.ui.green.button:hover, .ui.green.buttons .button:hover {
    background-color: #777777 !important;
}
</style>
